{
  "name": "simple-slider-app",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:all": "pnpm dev:all:py",
    "dev:all:py": "node ./scripts/dev-stack.mjs --mode web --backend py",
    "dev:all:cpp": "node ./scripts/dev-stack.mjs --mode web --backend cpp",
    "dev": "vite",
    "dev:tauri": "node ./scripts/tauri-dev.mjs",
    "tauri:dev:all": "pnpm tauri:dev:all:py",
    "tauri:dev:all:py": "node ./scripts/dev-stack.mjs --mode tauri --backend py",
    "tauri:dev:all:cpp": "node ./scripts/dev-stack.mjs --mode tauri --backend cpp",
    "tauri:dev": "node ./scripts/tauri-run.mjs",
    "build": "vite build",
    "tauri:build": "node ./scripts/tauri-build.mjs",
    "tauri:build:app": "tauri build --bundles app",
    "backend:py:install": "python3 -m pip install -r ./python/requirements.txt",
    "backend:cpp:build": "cmake -S ./cpp -B ./cpp/build && cmake --build ./cpp/build",
    "backend:cpp:run": "./cpp/build/bin/simple_slider_backend",
    "backend:cpp": "./cpp/build/bin/simple_slider_backend",
    "backend:py": "python3 ./python/backend_simple_slider.py"
  },
  "dependencies": {
    "@frameviz/vue": "workspace:*",
    "@vueuse/core": "^10.11.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "license": "MIT",
  "author": "qqfly"
}
