@PACKAGE_INIT@

# FrameViz C++ SDK CMake Config
# Usage: find_package(frameviz REQUIRED)
#        target_link_libraries(your_target frameviz::frameviz-cpp)

include(CMakeFindDependencyMacro)

# Note: nlohmann_json is bundled (header-only) in include/nlohmann/

# Find Threads (required by ixwebsocket)
find_dependency(Threads REQUIRED)
# zlib is required when ixwebsocket is built with permessage-deflate enabled
find_dependency(ZLIB QUIET)

# Handle ixwebsocket dependency
# For static library builds, frameviz-cpp depends on ixwebsocket.
# We bundle the ixwebsocket library in the SDK installation.
if(NOT TARGET ixwebsocket::ixwebsocket)
    # First, try to find the bundled ixwebsocket library in the SDK installation
    set(_IXWEBSOCKET_LIB_DIR "${PACKAGE_PREFIX_DIR}/lib")
    find_library(IXWEBSOCKET_LIBRARY
        NAMES ixwebsocket libixwebsocket
        PATHS "${_IXWEBSOCKET_LIB_DIR}"
        NO_DEFAULT_PATH
    )

    if(IXWEBSOCKET_LIBRARY)
        add_library(ixwebsocket::ixwebsocket STATIC IMPORTED)
        set_target_properties(ixwebsocket::ixwebsocket PROPERTIES
            IMPORTED_LOCATION "${IXWEBSOCKET_LIBRARY}"
            INTERFACE_LINK_LIBRARIES "Threads::Threads"
        )
        if(ZLIB_FOUND)
            set_property(TARGET ixwebsocket::ixwebsocket APPEND PROPERTY
                INTERFACE_LINK_LIBRARIES ZLIB::ZLIB
            )
        endif()
        if(WIN32)
            set_property(TARGET ixwebsocket::ixwebsocket APPEND PROPERTY
                INTERFACE_LINK_LIBRARIES wsock32 ws2_32 shlwapi)
        endif()
        message(STATUS "FrameViz: Using bundled ixwebsocket at ${IXWEBSOCKET_LIBRARY}")
    else()
        # Fallback: try system IXWebSocket
        find_dependency(IXWebSocket QUIET)
        if(NOT TARGET ixwebsocket::ixwebsocket)
            message(FATAL_ERROR "FrameViz C++ SDK requires ixwebsocket library, but it was not found in the SDK installation (${_IXWEBSOCKET_LIB_DIR}). The SDK installation may be corrupted.")
        endif()
    endif()
endif()

# Include targets
include("${CMAKE_CURRENT_LIST_DIR}/frameviz-targets.cmake")

# Create compatibility alias
if(TARGET frameviz::frameviz-cpp AND NOT TARGET frameviz::cpp)
    add_library(frameviz::cpp ALIAS frameviz::frameviz-cpp)
endif()

check_required_components(frameviz)
