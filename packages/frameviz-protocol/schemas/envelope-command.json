{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrameViz Command Envelope",
  "type": "object",
  "required": [
    "protocol_version",
    "type",
    "id",
    "name",
    "args"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^0\\.4\\.(0|[1-9][0-9]{0,8})$"
    },
    "type": {
      "const": "cmd"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "args": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
