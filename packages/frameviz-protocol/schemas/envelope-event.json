{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrameViz Event Envelope",
  "type": "object",
  "required": [
    "protocol_version",
    "type",
    "name",
    "data"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.4.0"
    },
    "type": {
      "const": "event"
    },
    "name": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}