{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrameViz Event Envelope",
  "type": "object",
  "required": [
    "protocol_version",
    "type",
    "name",
    "data"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^0\\.5\\.(0|[1-9][0-9]{0,8})$"
    },
    "type": {
      "const": "event"
    },
    "name": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
