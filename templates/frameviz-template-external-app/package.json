{
  "name": "frameviz-template-external-app",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "setup:local-sdk": "node ./scripts/setup-local-sdk.mjs",
    "check:runtime": "node ./scripts/check-runtime.mjs",
    "clean": "node ./scripts/clean.mjs",
    "dev:all": "pnpm dev:all:py",
    "dev:all:py": "node ./scripts/dev-stack.mjs --mode web --backend py",
    "dev:all:cpp": "node ./scripts/dev-stack.mjs --mode web --backend cpp",
    "dev": "pnpm check:runtime && vite",
    "dev:tauri": "pnpm tauri:dev",
    "tauri:dev:all": "pnpm tauri:dev:all:py",
    "tauri:dev:all:py": "node ./scripts/dev-stack.mjs --mode tauri --backend py",
    "tauri:dev:all:cpp": "node ./scripts/dev-stack.mjs --mode tauri --backend cpp",
    "tauri:dev": "pnpm check:runtime && node ./scripts/tauri-run.mjs",
    "build": "vite build",
    "tauri:build": "pnpm tauri:build:py",
    "tauri:build:py": "pnpm check:runtime && node ./scripts/tauri-build.mjs --backend py",
    "tauri:build:cpp": "pnpm check:runtime && node ./scripts/tauri-build.mjs --backend cpp",
    "icon:gen": "node ./scripts/generate-tauri-icons.mjs",
    "deb:install": "node ./scripts/install-deb.mjs",
    "preview": "vite preview",
    "backend:py": "python3 ./python/backend_external_app.py",
    "backend:cpp:build": "cmake -S ./cpp -B ./cpp/build && cmake --build ./cpp/build",
    "backend:cpp:stage": "node ./scripts/stage-cpp-backend.mjs",
    "backend:cpp": "./cpp/build/bin/frameviz_external_backend"
  },
  "dependencies": {
    "@frameviz/vue": "^0.4.0",
    "@vueuse/core": "^10.11.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "license": "MIT",
  "author": "qqfly"
}
